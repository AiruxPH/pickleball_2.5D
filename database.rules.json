{
  "rules": {
    ".read": false,
    ".write": false,
    "onlineRooms": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || root.child('onlineRooms').child($code).child('meta/hostUid').val() === auth.uid)",
          "hostUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'inGame' || newData.val() === 'closed')"
          }
        },
        "lobby": {
          ".write": "auth != null && root.child('onlineRooms').child($code).child('meta/hostUid').val() === auth.uid"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('onlineRooms').child($code).child('meta/hostUid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['role', 'slot', 'online']) && newData.child('role').isString() && newData.child('slot').isNumber() && newData.child('online').isBoolean())"
          }
        },
        "actions": {
          "$action": {
            ".write": "auth != null && ((!data.exists() && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('role').val() === 'client' && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('slot').val() === 1) || root.child('onlineRooms').child($code).child('meta/hostUid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('type').val() === 'toggleReady')"
          }
        },
        "ready": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('role').val() === 'client' && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('slot').val() === 1",
            ".validate": "newData.isBoolean()"
          }
        },
        "commands": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('role').val() === 'client' && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('slot').val() === 1",
            ".validate": "newData.hasChildren(['uid', 'slot', 'seq', 'cmd']) && newData.child('uid').val() === auth.uid && newData.child('slot').val() === 1 && newData.child('seq').isNumber() && newData.child('seq').val() > 0 && newData.child('cmd').child('type').isString()"
          }
        },
        "webrtc": {
          "offer": {
            ".write": "auth != null && root.child('onlineRooms').child($code).child('meta/hostUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['sdp', 'type', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('sdp').isString() && newData.child('type').val() === 'offer'"
          },
          "answer": {
            ".write": "auth != null && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('role').val() === 'client' && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('slot').val() === 1",
            ".validate": "newData.hasChildren(['sdp', 'type', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('sdp').isString() && newData.child('type').val() === 'answer'"
          },
          "candidates": {
            "host": {
              "$candidate": {
                ".write": "auth != null && root.child('onlineRooms').child($code).child('meta/hostUid').val() === auth.uid",
                ".validate": "newData.hasChildren(['candidate', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('candidate').isString()"
              }
            },
            "client": {
              "$candidate": {
                ".write": "auth != null && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('role').val() === 'client' && root.child('onlineRooms').child($code).child('members').child(auth.uid).child('slot').val() === 1",
                ".validate": "newData.hasChildren(['candidate', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('candidate').isString()"
              }
            }
          }
        },
        "snapshot": {
          ".write": "auth != null && root.child('onlineRooms').child($code).child('meta/hostUid').val() === auth.uid"
        },
        "start": {
          ".write": "auth != null && root.child('onlineRooms').child($code).child('meta/hostUid').val() === auth.uid"
        }
      }
    }
  }
}
